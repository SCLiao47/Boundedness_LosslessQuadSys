%%PageBoundingBox: 0 0 600 600
%%BeginPageSetup
N
    0     0 M
  601     0 L
  601   601 L
    0   601 L
cp
clip
[1 0 0 -1 0 600] CT
%%EndPageSetup
GS
1 GC
N
0 0 600 600 re
f
GR
GS
[0.48 0 0 0.48 0 24] CT
[1 0 0 1 0 0] CT
N
0 -50 M
1250 -50 L
1250 1200 L
0 1200 L
0 -50 L
cp
clip
GS
0 0 translate
1200 1200 scale
%AXGBeginBitmap: java.awt.image.BufferedImage
{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 1200
  /ImageMatrix [1200 0 0 1200 0 0]
  /Width 1200
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
